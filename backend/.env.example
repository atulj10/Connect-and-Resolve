# Database (Supabase PostgreSQL)
# Transaction pooler (for app connections)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (for migrations)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres"

# JWT
JWT_SECRET="change-me-to-a-random-string"
JWT_EXPIRES_IN="7d"

# Cloudinary (optional - logs to console when not set)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Twilio (optional - logs to console when not set)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Admin seed credentials (used by prisma/seed.ts)
ADMIN_NAME="Rajeev Menon"
ADMIN_EMAIL="admin@minister.gov.in"
ADMIN_PASSWORD="change-me-to-a-strong-password"

# SMTP / Nodemailer (optional - logs to console when not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""

# Server
PORT=4000
NODE_ENV=development
