# Database
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="change-me-to-a-random-string"
JWT_EXPIRES_IN="7d"

# Cloudinary (optional - logs to console when not set)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Twilio (optional - logs to console when not set)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Resend (optional - logs to console when not set)
RESEND_API_KEY=""

# Server
PORT=4000
NODE_ENV=development
